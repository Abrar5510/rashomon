    "path": "examples/timelib.py",
    "qualname": "parse_duration",
    "signature": "parse_duration(text: str) -> int",
    "source": "def parse_duration(text: str) -> int:\n    \"\"\"Parse a duration like '1h30m' into whole seconds.\"\"\"\n    weights = {\"h\": 3600, \"m\": 60, \"s\": 1}\n    seconds = 0\n    digits = \"\"\n    for ch in text:\n        if ch.isdigit():\n            digits += ch\n        elif ch in weights and digits:\n            seconds += int(digits) * weights[ch]\n            digits = \"\"\n    if digits:\n        seconds += int(digits)\n    return seconds",
    "docstring": "Parse a duration like '1h30m' into whole seconds.",
    "n_lines": 14,
